# === 通用构建/缓存产物 ===
__pycache__
*.o
build
cmake/sys.cmake.ext
*.png

# === 模拟 restart / log / 可视化中间产物 ===
*.exadis
exadis.log
*.vtk
vtk/

# === bccTi 算例 ===
bccTi/*/output/*
bccTi/relax_*/
!bccTi/*/output/stress_strain_dens.dat
!bccTi/*/output/timer.dat
!bccTi/*/slurm-*.out

# === FCC cross-slip 算例 ===
# 按文件类型忽略大文件，不忽略 output 目录本身——
# 目录一旦被忽略，下面的 ! 白名单就永远失效（Git 硬性规则）
a_test_cross_slip/**/config.*.data
a_test_cross_slip/**/slurm-*.out
a_test_cross_slip/**/output*/*.exadis

# === 例外：放行关键结果 ===
!a_test_cross_slip/**/output*/stress_strain_dens.dat
!a_test_cross_slip/**/output*/timer.dat
# DDD 中间构型输出，体积大且可复现，不入库
config.*.data
